# MasterOCR environment variables
# Copy to .env and fill in what you have. Every key is optional — engines
# without credentials simply report as unavailable.

# --- server ---------------------------------------------------------------
PORT=8000
DATA_DIR=./data
LOG_LEVEL=info

# --- limits ---------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_PAGES=25
RETENTION_HOURS=72
RASTER_DPI=300
MAX_CONCURRENT_ENGINES=4
DEFAULT_TIMEOUT_S=180

# Set to true only if the image was built with --build-arg INSTALL_HEAVY=true
INSTALL_HEAVY=false

# --- Tier 3: free-tier cloud APIs ----------------------------------------
OCRSPACE_KEY=
GOOGLE_VISION_KEY=
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
GEMINI_KEY=
OPENROUTER_KEY=
MISTRAL_KEY=
LLAMAPARSE_KEY=

# --- Tier 4: paid cloud APIs ---------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
DATALAB_KEY=
DEEPINFRA_KEY=
OPENAI_KEY=
ANTHROPIC_KEY=
GOOGLE_DOCAI_PROJECT=
NANONETS_KEY=
MINDEE_KEY=
REDUCTO_KEY=
